{
  "functions": {
    "index.php":          { "runtime": "vercel-php@0.7.2" },
    "about.php":          { "runtime": "vercel-php@0.7.2" },
    "services.php":       { "runtime": "vercel-php@0.7.2" },
    "work.php":           { "runtime": "vercel-php@0.7.2" },
    "contact.php":        { "runtime": "vercel-php@0.7.2" },
    "send-mail.php":      { "runtime": "vercel-php@0.7.2" },
    "privacy-policy.php": { "runtime": "vercel-php@0.7.2" },
    "terms.php":          { "runtime": "vercel-php@0.7.2" },
    "404.php":            { "runtime": "vercel-php@0.7.2" }
  },
  "rewrites": [
    { "source": "/about",          "destination": "/about.php" },
    { "source": "/services",       "destination": "/services.php" },
    { "source": "/work",           "destination": "/work.php" },
    { "source": "/contact",        "destination": "/contact.php" },
    { "source": "/privacy-policy", "destination": "/privacy-policy.php" },
    { "source": "/terms",          "destination": "/terms.php" }
  ]
}
